{
    "name": "kurusa/instagram-scraper",
    "description": "Framework-independent Instagram GraphQL scraping client.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Kurusa\\InstagramScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kurusa\\InstagramScraper\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "minimum-stability": "stable"
}
